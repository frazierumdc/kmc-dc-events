{
  "hosting": {
    "public": "apps/web/dist",
    "trailingSlash": false,
    "ignore": ["**/.*"],
    "redirects": [{ "source": "/app", "destination": "/get-app", "type": 301 }],
    "rewrites": [
      {
        "source": "/v2/feed/calendar/**",
        "destination": "/v2/feed/calendar/not-found"
      },
      {
        "source": "/v2/feed/pictures/**",
        "destination": "/v2/feed/pictures/not-found"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "X-Robots-Tag",
            "value": "noindex"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/!(*.*)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/e/*/share.png",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/v2/feed/snapshots/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/v2/feed/pictures/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "/v2/feed/manifest.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, s-maxage=30, stale-while-revalidate=30"
          }
        ]
      },
      {
        "source": "/v2/feed/latest.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, s-maxage=30, stale-while-revalidate=30"
          }
        ]
      },
      {
        "source": "/v2/feed/calendar/**",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/calendar; charset=utf-8"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "database": {
    "rules": "database.rules.json"
  },
  "functions": [
    {
      "source": "apps/functions/deploy",
      "codebase": "default",
      "runtime": "nodejs24",
      "predeploy": ["pnpm --filter @kmcdc/functions build"],
      "ignore": ["node_modules", ".*", "*.log"]
    }
  ]
}
