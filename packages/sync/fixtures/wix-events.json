    "description": {
      "nodes": [
        {
          "type": "PARAGRAPH",
          "nodes": [
            {
              "type": "TEXT",
              "nodes": [],
              "textData": {
                "text": "With Buddhist Teacher A. Example"
              }
            }
          ]
        },
        {
          "type": "PARAGRAPH",
          "nodes": []
        },
        {
          "type": "PARAGRAPH",
          "nodes": [
            {
              "type": "TEXT",
              "nodes": [],
              "textData": {
                "text": "Each session includes simple guided meditations to help settle your mind, release stress and negativity, and create space for peace and positivity. You'll also have a chance to reflect on uplifting perspectives that you can take into the rest of your week."
              }
            }
          ]
        },
        {
          "type": "PARAGRAPH",
          "nodes": []
        },
        {
          "type": "PARAGRAPH",
          "nodes": [
            {
              "type": "TEXT",
              "nodes": [],
              "textData": {
                "text": "Whether you've had a busy day at work or simply need a moment to pause, this class offers the perfect opportunity to unwind, recharge, and reconnect with your inner peace."
              }
            }
          ]
        },
        {
          "type": "PARAGRAPH",
          "nodes": []
        },
        {
          "type": "PARAGRAPH",
          "nodes": [
            {
              "type": "TEXT",
              "nodes": [],
              "textData": {
                "text": "Everyone is welcome—no previous meditation experience is needed."
              }
            }
          ]
        },
        {
          "type": "PARAGRAPH",
          "nodes": []
        }
      ]
    }
