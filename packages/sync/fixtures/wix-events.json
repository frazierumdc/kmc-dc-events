  "online": {
    "id": "9cdbd199-88a1-4b81-a6f3-eb83bb122901",
    "slug": "online-silent-saturday-a-heart-of-gratitude",
    "title": "Online: Silent Saturday: A Heart of Gratitude",
    "status": "UPCOMING",
    "shortDescription": "Step back, reconnect with a grateful heart, and cultivate a more positive, balanced perspective.",
    "detailedDescription": "Join us Mondays for teachings on how to decrease stress and increase inner peace through Buddha&#39;s timeless wisdom.",
    "location": {
      "name": "Online Conference",
      "type": "ONLINE",
      "locationTbd": false
    },
    "dateAndTimeSettings": {
      "dateAndTimeTbd": false,
      "startDate": "2026-10-17T14:00:00.000Z",
      "endDate": "2026-10-17T17:00:00.000Z",
      "timeZoneId": "America/New_York",
      "hideEndDate": false,
      "recurrenceStatus": "ONE_TIME",
      "recurringEvents": {}
    },
    "mainImage": {
      "url": "https://static.wixstatic.com/media/7399f8_43ce231c0c4c4ab0bf11eae95c60f203~mv2.jpg"
    },
    "eventPageUrl": {
      "base": "https://www.example.org",
      "path": "/event-details/online-silent-saturday-a-heart-of-gratitude"
    },
    "registration": {
      "type": "TICKETING",
      "status": "OPEN_TICKETS"
    },
    "categories": [
      {
        "id": "d5364752-1fa9-40ab-9aca-6ef2c292b9a6",
        "name": "Online Special Events"
      }
    ],
    "eventDisplaySettings": {},
    "createdDate": "2026-07-15T15:22:40.584Z",
    "updatedDate": "2026-09-30T18:43:03.000Z",
    "publishedDate": "2026-07-15T15:32:03.912Z",
    "description": {
      "nodes": [
        {
          "type": "PARAGRAPH",
          "nodes": [
            {
              "type": "TEXT",
              "nodes": [],
              "textData": {
                "text": "with Teacher C. Example"
              }
            }
          ]
        },
        {
          "type": "PARAGRAPH",
          "nodes": []
        },
        {
          "type": "PARAGRAPH",
          "nodes": [
            {
              "type": "TEXT",
              "nodes": [],
              "textData": {
                "text": "Step back, reconnect with a grateful heart, and cultivate a more positive, balanced perspective. By learning to recognize the kindness we have received throughout our life, we naturally reduce negative states such as resentment, irritation, and loneliness, and instead develop patience, love, and joy."
              }
            }
          ]
        },
        {
          "type": "PARAGRAPH",
          "nodes": []
        },
        {
          "type": "PARAGRAPH",
          "nodes": [
            {
              "type": "TEXT",
              "nodes": [],
              "textData": {
                "text": "Through these contemplations, we can begin to see others—not as sources of frustration—but as sources of kindness and opportunity. Come and discover how a heart of gratitude can bring peace to your mind and harmony to your relationships."
              }
            }
          ]
        },
        {
          "type": "PARAGRAPH",
          "nodes": []
        },
        {
          "type": "PARAGRAPH",
          "nodes": [
            {
              "type": "TEXT",
              "nodes": [],
              "textData": {
                "text": "This half-day silent, gadget-free retreat offers a chance to step away from the constant noise of life and our devices, and instead reconnect with the clarity and calm within. In the quiet, you’ll experience the liberating power of silence, introspection, and meditation—an opportunity to reset your mind and return to your life feeling refreshed, grounded, and inspired. Suitable for both new and experienced meditators alike."
              }
            }
          ]
        },
        {
          "type": "PARAGRAPH",
          "nodes": []
        },
        {
          "type": "PARAGRAPH",
          "nodes": [
            {
              "type": "TEXT",
              "nodes": [],
              "textData": {
                "text": "What to expect on retreat day:"
              }
            }
          ]
        },
        {
          "type": "BULLETED_LIST",
          "nodes": [
            {
              "type": "LIST_ITEM",
              "nodes": [
                {
                  "type": "PARAGRAPH",
                  "nodes": [
                    {
                      "type": "TEXT",
                      "nodes": [],
                      "textData": {
                        "text": "Simple and profound guided meditations"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "type": "LIST_ITEM",
              "nodes": [
                {
                  "type": "PARAGRAPH",
                  "nodes": [
                    {
                      "type": "TEXT",
                      "nodes": [],
                      "textData": {
                        "text": "Brief teachings about each meditation"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "type": "LIST_ITEM",
              "nodes": [
                {
                  "type": "PARAGRAPH",
                  "nodes": [
                    {
                      "type": "TEXT",
                      "nodes": [],
                      "textData": {
                        "text": "Silent breaks for tea, contemplation or reading"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "type": "LIST_ITEM",
              "nodes": [
                {
                  "type": "PARAGRAPH",
                  "nodes": [
                    {
                      "type": "TEXT",
                      "nodes": [],
                      "textData": {
                        "text": "Opportunities for Q&A and discussion at the end"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "type": "LIST_ITEM",
              "nodes": [
                {
                  "type": "PARAGRAPH",
                  "nodes": [
                    {
                      "type": "TEXT",
                      "nodes": [],
                      "textData": {
                        "text": "No experience necessary; everyone is welcome"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "PARAGRAPH",
          "nodes": []
        },
        {
          "type": "PARAGRAPH",
          "nodes": [
            {
              "type": "TEXT",
              "nodes": [],
              "textData": {
                "text": "Schedule:"
              }
            }
          ]
        },
        {
          "type": "BULLETED_LIST",
          "nodes": [
            {
              "type": "LIST_ITEM",
              "nodes": [
                {
                  "type": "PARAGRAPH",
                  "nodes": [
                    {
                      "type": "TEXT",
                      "nodes": [],
                      "textData": {
                        "text": "10 to 10:45AM: Teaching and Guided Meditation "
                      }
                    }
                  ]
                }
              ]
            },
            {
              "type": "LIST_ITEM",
              "nodes": [
                {
                  "type": "PARAGRAPH",
                  "nodes": [
                    {
                      "type": "TEXT",
                      "nodes": [],
