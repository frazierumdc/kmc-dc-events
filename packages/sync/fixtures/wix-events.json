    "description": {
      "nodes": [
        {
          "type": "PARAGRAPH",
          "nodes": [
            {
              "type": "TEXT",
              "nodes": [],
              "textData": {
                "text": "with Resident Teacher B. Example"
              }
            }
          ]
        },
        {
          "type": "PARAGRAPH",
          "nodes": []
        },
        {
          "type": "PARAGRAPH",
          "nodes": [
            {
              "type": "TEXT",
              "nodes": [],
              "textData": {
                "text": "Join us for this very special way to close 2026 and bring in the New Year!"
              }
            }
          ]
        },
        {
          "type": "PARAGRAPH",
          "nodes": []
        },
        {
          "type": "PARAGRAPH",
          "nodes": [
            {
              "type": "TEXT",
              "nodes": [],
              "textData": {
                "text": "Together we’ll meditate on our compassionate wish for freedom from all conflict and inner peace for all beings. We’ll engage in the beautiful practice of Avalokiteshvara, the Buddha of Compassion, sending mantras of compassion and healing out to the whole world, and dedicating our evening to world peace."
              }
            }
          ]
        },
        {
          "type": "PARAGRAPH",
          "nodes": []
        },
        {
          "type": "PARAGRAPH",
          "nodes": [
            {
              "type": "TEXT",
              "nodes": [],
              "textData": {
                "text": "Enter the new year with a positive mind, a peaceful heart, and meaningful resolutions that will set you up for the year ahead.  "
              }
            }
          ]
        },
        {
          "type": "PARAGRAPH",
          "nodes": []
        },
        {
          "type": "PARAGRAPH",
          "nodes": [
            {
              "type": "TEXT",
              "nodes": [],
              "textData": {
                "text": "The event includes a guided meditation and inspiring commentary. No experience necessary. Everyone welcome!"
              }
            }
          ]
        },
        {
          "type": "PARAGRAPH",
          "nodes": []
        }
      ]
    }
  },
